{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soccentric.com/schemas/acadia-instrumentation/device-contract-v1.json",
  "title": "Acadia Instrumentation device-facing contract metadata",
  "type": "object",
  "required": ["contract", "contract_version"],
  "properties": {
    "$schema": {"type": "string"},
    "contract": {"const": "acadia-instrumentation-device"},
    "contract_version": {"const": 1},
    "suite_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "proto_schema_version": {"type": "integer", "const": 3},
    "proto_descriptor": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "alarm_catalog": {
      "type": "object",
      "required": ["revision", "path", "sha256"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
